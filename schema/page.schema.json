{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kairo-pdf-json/page/0.2",
  "title": "電気図面 1頁分の構造化データ",
  "description": "1頁に描かれている機器・端子・線・PLC入出力・他頁参照を三層で表す。(1) 図のまま：ports・junctions・wires（線は向きのない端と端の組）。(2) 電気的なつながり：nets（wires からプログラムが計算する）。(3) 回路の筋：circuits（プログラムが計算する。信号の向きはここだけに、状態つきで持つ）。座標は頁の左上原点、単位 pt。ポートは「機器ID:端子名」（例 XT31:420、X01:12、A1:X0.00）。端子名が図にない接点は、接点の種類（a/b/c）と 1/2（左または上が 1）で表す（例 SQ4:b.1）。電源線は rail:名前（例 rail:1L+）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "sheet", "components", "ports", "junctions", "wires", "open_ends", "nets", "circuits", "plc_io", "cross_references", "unresolved"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_id", "page", "pdf_kind"],
      "properties": {
        "sample_id": {"type": "string"},
        "page": {"type": "integer", "minimum": 1},
        "pdf_kind": {"enum": ["vector", "vector_outlined_text", "raster"]}
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "description": "表題欄は当面持たない（SPEC §6.3）。頁名と頁番号、頁の書式だけ持つ",
      "properties": {
        "title": {"type": "string"},
        "sheet_id": {"oneOf": [{"$ref": "#/$defs/sourced"}, {"type": "null"}], "description": "他頁から参照されるときの頁番号"},
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "orientation": {"enum": ["horizontal", "vertical", "mixed", "table", "other"], "description": "horizontal=横書き（電源線が左、回路が右へ流れる）"},
            "location_system": {"enum": ["line_number", "zone_grid", "column_number", "none"]},
            "lines": {"type": "string"},
            "columns": {"type": "string"},
            "label_placement": {"type": "string", "description": "名前の置き方（例：above=記号の真上に名前、その下に番号）"},
            "junction_rule": {"type": "string", "description": "接続の描き方（例：T字や交差は黒丸がある所だけつながる）"}
          }
        }
      }
    },
    "regions": {
      "type": "array",
      "description": "機器をまとめる枠（MACHINE SIDE、ユニット TU(A11) など）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "kind": {"enum": ["area", "unit", "other"]},
          "meaning": {"type": ["string", "null"], "description": "例：機械側（機械本体に付く部品）"},
          "bbox": {"$ref": "#/$defs/bbox", "description": "枠の範囲"},
          "label_bbox": {"$ref": "#/$defs/bbox"}
        }
      }
    },
    "rails": {
      "type": "array",
      "description": "頁の電源線。極性は向きを決める元になる事実",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "polarity"],
        "properties": {
          "id": {"type": "string", "pattern": "^rail:.+$"},
          "name": {"type": "string"},
          "polarity": {"enum": ["plus", "zero", "ac", "ground", "unknown"]},
          "polarity_basis": {"$ref": "#/$defs/sourced"},
          "pos": {"$ref": "#/$defs/point"},
          "label_bbox": {"$ref": "#/$defs/bbox"}
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "description": "図面上の機器記号（SQ1、KA4、XT31、A1 など）"},
          "name": {"type": ["string", "null"], "description": "機器記号と別に書かれた名前（NC(A1) の NC など）"},
          "kind": {"type": "string", "description": "limit_switch, relay, terminal_block, connector, plc_unit, resistor, diode, indicator_lamp, unit など"},
          "symbol": {"type": ["string", "null"], "description": "記号の名前（記号辞書の名前）"},
          "region": {"type": ["string", "null"], "description": "設置場所（regions の id）"},
          "purpose": {"oneOf": [{"$ref": "#/$defs/sourced"}, {"type": "null"}]},
          "label_bbox": {"$ref": "#/$defs/bbox"},
          "loc": {"$ref": "#/$defs/loc"},
          "terminals": {"type": "array", "items": {"type": "string"}, "description": "この頁に現れる端子名・ピン名（端子台・コネクタ・ユニット）"},
          "elements": {
            "type": "array",
            "description": "2端子の働く部分（接点、コイル、抵抗、ダイオード、表示灯など）。1つの機器に複数あってよい（リミットスイッチの a接点と b接点など）",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "ports"],
              "properties": {
                "id": {"type": "string", "description": "機器の中での名前（a、b、coil、body など）"},
                "kind": {"enum": ["contact", "coil", "resistor", "diode", "lamp", "other"]},
                "contact": {"enum": ["a", "b", "c", "unknown"], "description": "接点の種類（JIS）：a=普段は開、b=普段は閉、c=切り替え"},
                "symbol": {"type": ["string", "null"]},
                "ports": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/port"}},
                "loc": {"$ref": "#/$defs/loc"}
              }
            }
          },
          "linked_with": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "ports": {
      "type": "array",
      "description": "この頁に現れるすべてのポートと、図の上の位置",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"$ref": "#/$defs/port"},
          "pos": {"$ref": "#/$defs/point"},
          "label_bboxes": {"type": "array", "items": {"$ref": "#/$defs/bbox"}, "description": "このポートの名前・番号の文字の位置"}
        }
      }
    },
    "junctions": {
      "type": "array",
      "description": "接続点（黒丸）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pos"],
        "properties": {
          "id": {"type": "string", "pattern": "^J[0-9]+$"},
          "pos": {"$ref": "#/$defs/point"}
        }
      }
    },
    "wires": {
      "type": "array",
      "description": "図のままの線。向きのない端と端の組。端はポート、接続点（J…）、電源線（rail:…）のどれか",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ends"],
        "properties": {
          "id": {"type": "string"},
          "ends": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/end"}},
          "path": {"type": "array", "items": {"$ref": "#/$defs/point"}, "description": "線の通り道（端から端まで、曲がり角を含む）"}
        }
      }
    },
    "open_ends": {
      "type": "array",
      "description": "この頁では先が描かれていない端",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["port", "note"],
        "properties": {
          "port": {"$ref": "#/$defs/port"},
          "note": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "nets": {
      "type": "array",
      "description": "電気的なつながり。wires からプログラムが計算する（手で書かない）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "members"],
        "properties": {
          "id": {"type": "string"},
          "rail": {"type": ["string", "null"], "description": "このネットに含まれる電源線（rail:1L+ など）"},
          "wire_no": {"oneOf": [{"$ref": "#/$defs/sourced"}, {"type": "null"}]},
          "kind": {"enum": ["power", "signal", "ground", "other"]},
          "members": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/port"}},
          "open_ends": {"type": "array", "items": {"$ref": "#/$defs/port"}}
        }
      }
    },
    "circuits": {
      "type": "array",
      "description": "回路の筋。nets と components からプログラムが計算する（AI に書かせない）",
      "items": {
        "type": "object",
        "required": ["id", "title", "from", "to", "expression", "direction"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "kind": {"enum": ["to_receiver", "to_return", "other"]},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "expression": {"type": "string", "description": "並列は ∥、直列は →、ネットは [ ] で表す"},
          "elements": {"type": "array", "items": {"type": "string"}},
          "nets": {"type": "array", "items": {"type": "string"}},
          "routes": {"type": "array", "items": {"type": "object"}},
          "open_ends": {"type": "array", "items": {"$ref": "#/$defs/port"}},
          "direction": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {"enum": ["confirmed", "inferred", "unknown"]},
              "basis": {"type": "string"}
            }
          }
        }
      }
    },
    "plc_io": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["address", "direction"],
        "properties": {
          "address": {"type": "string"},
          "direction": {"enum": ["input", "output"]},
          "unit": {"type": ["string", "null"]},
          "port": {"$ref": "#/$defs/port"},
          "device": {"type": ["string", "null"], "description": "このアドレスにつながる現場機器"},
          "comment": {"type": ["string", "null"]},
          "loc": {"$ref": "#/$defs/loc"}
        }
      }
    },
    "cross_references": {
      "type": "array",
      "description": "他頁への参照（コイルと接点の対応、信号名の矢印など）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "kind"],
        "properties": {
          "text": {"type": "string", "description": "図面上の表記のまま（例 0700/23）"},
          "kind": {"enum": ["contact_location", "coil_location", "continuation", "other"]},
          "component": {"type": ["string", "null"]},
          "target": {"type": "object", "additionalProperties": false, "properties": {"sheet": {"type": ["string", "null"]}, "line": {"type": ["integer", "null"]}, "page": {"type": ["integer", "null"], "description": "PDF の頁番号（分かれば）"}}},
          "loc": {"$ref": "#/$defs/loc"}
        }
      }
    },
    "tables": {
      "type": "array",
      "description": "図中の表（機種の表など）。セルは書いてあるとおり",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rows"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": ["string", "null"]},
          "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
          "note": {"type": ["string", "null"]},
          "bbox": {"$ref": "#/$defs/bbox"}
        }
      }
    },
    "unresolved": {
      "type": "array",
      "description": "読み取れなかった・判断できなかった箇所。推測で埋めない",
      "items": {"type": "object", "additionalProperties": false, "required": ["what", "reason"], "properties": {"what": {"type": "string"}, "reason": {"type": "string"}, "loc": {"$ref": "#/$defs/loc"}}}
    },
    "needs_review": {
      "type": "array",
      "description": "要確認リスト（推定で埋めた所、未解決、食い違い、検証ルール違反）。人が確認した結果も残す",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["what", "reason"],
        "properties": {
          "what": {"type": "string"},
          "reason": {"type": "string"},
          "ref": {"type": ["string", "null"]},
          "decision": {"type": ["string", "null"]},
          "decided_by": {"type": ["string", "null"]},
          "decided_at": {"type": ["string", "null"]}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "description": "正解データのときだけ使う",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["draft", "reviewed"]},
        "drafted_by": {"type": "string"},
        "reviewed_by": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"]},
        "questions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "question"], "properties": {"id": {"type": "string"}, "question": {"type": "string"}, "draft_answer": {"type": "string"}, "answer": {"type": ["string", "null"]}}}},
        "history": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "port": {"type": "string", "pattern": "^[^:\\s]+:.+$"},
    "end": {"type": "string", "pattern": "^(J[0-9]+|rail:.+|[^:\\s]+:.+)$"},
    "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "loc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line": {"type": ["integer", "null"]},
        "col": {"type": ["string", "null"]},
        "bbox": {"$ref": "#/$defs/bbox"}
      }
    },
    "sourced": {
      "type": "object",
      "additionalProperties": false,
      "description": "出所つきの値。basis：drawing=図に記載、other_page=図面集の別の頁、inferred=推定、human=人の回答。inferred は確定扱いにしない",
      "required": ["value", "basis"],
      "properties": {
        "value": {"type": "string"},
        "basis": {"enum": ["drawing", "other_page", "inferred", "human"]},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
